# Secrets only. Non-secret configuration uses Settings defaults in code.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insightforge
GEMINI_API_KEY=
TAVILY_API_KEY=

# Planner selection: simple (deterministic) or llm (Gemini-backed)
PLANNER_TYPE=simple
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
